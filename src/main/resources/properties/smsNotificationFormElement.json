[
    {
        "title": "UI & OTP Configuration",
        "properties": [
            {
                "name": "id",
                "label": "Element ID",
                "type": "textfield",
                "required": "true"
            },
            {
                "name": "label",
                "label": "Label",
                "type": "textfield",
                "value": "Phone Number Verification"
            },
            {
                "name": "placeholder",
                "label": "Placeholder Text",
                "type": "textfield",
                "value": "Enter phone number (e.g. +1234567890)"
            },
            {
                "name": "sendOtpButtonLabel",
                "label": "Send OTP Button Label",
                "type": "textfield",
                "value": "Send OTP",
                "required": "true"
            },
            {
                "name": "verifyOtpButtonLabel",
                "label": "Verify OTP Button Label",
                "type": "textfield",
                "value": "Verify OTP",
                "required": "true"
            },
            {
                "name": "buttonClass",
                "label": "Button CSS Class",
                "type": "textfield",
                "value": "btn btn-primary"
            },
            {
                "name": "otpMessageTemplate",
                "label": "OTP SMS Message Template",
                "type": "textarea",
                "rows": "3",
                "value": "Your verification code is: {otp}",
                "description": "Template for SMS message text. Use {otp} placeholder for generated OTP code."
            },
            {
                "name": "successMessage",
                "label": "Success Verification Message",
                "type": "textfield",
                "value": "Phone number verified successfully!"
            },
            {
                "name": "errorMessage",
                "label": "Error / Invalid OTP Message",
                "type": "textfield",
                "value": "Invalid or expired OTP code. Please try again."
            }
        ]
    },
    {
        "title": "Provider Configuration",
        "properties": [
            {
                "name": "provider",
                "label": "Provider / API Type",
                "type": "selectbox",
                "value": "custom",
                "options": [
                    { "value": "custom", "label": "Custom / Generic REST API" },
                    { "value": "twilio", "label": "Twilio SMS / WhatsApp" },
                    { "value": "nexmo", "label": "Vonage / Nexmo SMS" },
                    { "value": "infobip", "label": "Infobip SMS" },
                    { "value": "plivo", "label": "Plivo SMS" },
                    { "value": "brevo", "label": "Brevo Transactional SMS" },
                    { "value": "msg91", "label": "Msg91 SMS" }
                ]
            }
        ]
    },
    {
        "title": "Twilio Template Settings",
        "control_field": "provider",
        "control_value": "twilio",
        "properties": [
            {
                "name": "twilioEndpoint",
                "label": "Function / Action",
                "type": "selectbox",
                "value": "https://api.twilio.com/2010-04-01/Accounts/{accountSid}/Messages.json",
                "control_field": "provider",
                "control_value": "twilio",
                "options": [
                    { "value": "https://api.twilio.com/2010-04-01/Accounts/{accountSid}/Messages.json", "label": "Send SMS / WhatsApp" },
                    { "value": "custom", "label": "Custom Endpoint URL" }
                ]
            },
            {
                "name": "twilioCustomEndpoint",
                "label": "Custom Endpoint URL",
                "type": "textfield",
                "control_field": "twilioEndpoint",
                "control_value": "custom",
                "description": "Enter custom URL if using a specific Twilio API endpoint. Accepts Hash Variables."
            },
            {
                "name": "twilioAccountSid",
                "label": "Twilio Account SID",
                "type": "textfield",
                "control_field": "provider",
                "control_value": "twilio",
                "description": "e.g., ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx. Accepts Hash Variables."
            },
            {
                "name": "twilioAuthToken",
                "label": "Twilio Auth Token",
                "type": "password",
                "control_field": "provider",
                "control_value": "twilio",
                "description": "Twilio Auth Token. Accepts Hash Variables."
            },
            {
                "name": "twilioFrom",
                "label": "From (Sender Phone Number / Messaging SID)",
                "type": "textfield",
                "control_field": "provider",
                "control_value": "twilio",
                "description": "e.g., +16895885674 or #form.sender_phone#."
            }
        ]
    },
