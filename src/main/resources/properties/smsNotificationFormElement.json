    {
        "title": "Custom API Configuration",
        "control_field": "provider",
        "control_value": "custom",
        "properties": [
            {
                "name": "apiEndpoint",
                "label": "API Endpoint URL",
                "type": "textfield",
                "control_field": "provider",
                "control_value": "custom",
                "description": "e.g., https://api.example.com/v1/messages. Accepts Hash Variables."
            },
            {
                "name": "httpMethod",
                "label": "HTTP Method",
                "type": "selectbox",
                "value": "POST",
                "control_field": "provider",
                "control_value": "custom",
                "options": [
                    { "value": "POST", "label": "POST" },
                    { "value": "GET", "label": "GET" },
                    { "value": "PUT", "label": "PUT" },
                    { "value": "DELETE", "label": "DELETE" }
                ]
            },
            {
                "name": "contentType",
                "label": "Content-Type Header",
                "type": "selectbox",
                "value": "application/json",
                "control_field": "provider",
                "control_value": "custom",
                "options": [
                    { "value": "application/x-www-form-urlencoded", "label": "Form URL-Encoded" },
                    { "value": "application/json", "label": "JSON (application/json)" },
                    { "value": "text/plain", "label": "Text (text/plain)" }
                ]
            },
            {
                "name": "from",
                "label": "From (Sender ID / Phone)",
                "type": "textfield",
                "control_field": "provider",
                "control_value": "custom",
                "description": "Sender ID or From Phone Number. Accepts Hash Variables."
            },
            {
                "name": "authHeaderName",
                "label": "Authorization Header Name",
                "type": "textfield",
                "value": "Authorization",
                "control_field": "provider",
                "control_value": "custom"
            },
            {
                "name": "authHeaderValue",
                "label": "Authorization Header Value",
                "type": "password",
                "control_field": "provider",
                "control_value": "custom",
                "description": "e.g., 'Basic {base_64_string}' or 'Bearer {token}'. Accepts Hash Variables."
            },
            {
                "name": "payloadTemplate",
                "label": "Custom Payload Template (Optional)",
                "type": "textarea",
                "rows": "6",
                "control_field": "provider",
                "control_value": "custom",
                "description": "Optional custom payload template. If left blank, payload is automatically constructed from To (user phone), From, and Message (OTP text)."
            }
        ]
    },
    {
        "title": "Additional HTTP Headers",
        "properties": [
            {
                "name": "headersGrid",
                "label": "Custom HTTP Headers",
                "type": "grid",
                "columns": [
                    { "key": "headerName", "label": "Header Name" },
                    { "key": "headerValue", "label": "Header Value" }
                ],
                "description": "Add optional extra HTTP headers for ANY provider (e.g. X-Custom-Header, User-Agent). Accepts Hash Variables."
            },
            {
                "name": "customHeaders",
                "label": "Custom Additional Headers (Text)",
                "type": "textarea",
                "rows": "3",
                "description": "Optional extra headers, one per line (e.g. Header-Name: Header-Value). Hash Variables supported."
            }
        ]
    }
